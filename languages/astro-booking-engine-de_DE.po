msgid "Astro Booking Engine"
msgstr "Astro Booking Engine"

#. Plugin URI of the plugin
#: astro-booking-engine.php
msgid "https://wordpress.org/plugins/astro-booking-engine"
msgstr "https://wordpress.org/plugins/astro-booking-engine"

#. Description of the plugin
#: astro-booking-engine.php
msgid "Hotel booking form via Gutenberg block or shortcode, independent from the provider: switch booking engine anytime, your form stays the same."
msgstr "Hotel-Buchungsformular über Gutenberg-Block oder Shortcode, unabhängig vom Anbieter: Wechseln Sie die Buchungsmaschine jederzeit, Ihr Formular bleibt gleich."

#. Author of the plugin
#: astro-booking-engine.php
msgid "Alian Schiavoncini"
msgstr "Alian Schiavoncini"

#. Author URI of the plugin
#: astro-booking-engine.php
msgid "https://www.alian.it"
msgstr "https://www.alian.it"

